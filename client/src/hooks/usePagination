import { useEffect, useState } from "react";

// ---------------------------------------------------------------------------
// usePagination
//
// Client-side pagination for an already-loaded array — Notifications, Jobs,
// and Customers all fetch their full dataset up front via their hooks, so
// there's no need for a paginated Firestore query; this just slices what's
// already in memory.
//
// Resets to page 1 whenever `items` changes identity (new search term,
// tab switch, filter, or a fresh load) — otherwise a filter that shrinks
// the list could leave the view stuck on a page that no longer exists.
// ---------------------------------------------------------------------------
export function usePagination(items, pageSize = 10) {
  const [currentPage, setCurrentPage] = useState(1);

  const totalPages = Math.max(1, Math.ceil(items.length / pageSize));

  useEffect(() => {
    setCurrentPage(1);
  }, [items]);

  // Guard against the current page becoming invalid if totalPages shrinks
  // (e.g. items updates without a full identity change in some edge case).
  const safePage = Math.min(currentPage, totalPages);

  const start = (safePage - 1) * pageSize;
  const pageItems = items.slice(start, start + pageSize);

  return {
    pageItems,
    currentPage: safePage,
    totalPages,
    setPage: setCurrentPage,
  };
}